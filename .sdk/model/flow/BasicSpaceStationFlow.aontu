# BasicSpaceStationFlow

main: kit: flow: BasicSpaceStationFlow:
{
  entity: "space_station",
  kind: "basic",
  name: "BasicSpaceStationFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "space_station_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "space_station_ref01",
        srcdatavar: "space_station_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "space_station01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-space_station_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSpaceStationFlow"
}
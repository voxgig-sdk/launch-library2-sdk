              }
            ]
          }
          method: "GET"
          orig: "/config/spacecraft"
          parts: [
            "config"
            "spacecraft"
          ]
          select: {
            exist: [
              "limit"
              "offset"
              "search"
              "status"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"

              }
            ]
          }
          method: "GET"
          orig: "/config/spacecraft/{id}"
          parts: [
            "config"
            "spacecraft"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }




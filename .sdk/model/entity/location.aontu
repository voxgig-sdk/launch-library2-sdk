# Entity: location

main: kit: entity: location: {

  alias: field: {}

  fields: {
    country_code: {
      h: "Country Code"
      n: "country_code"
      r: false
      sh: "ISO country code"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Location ID"
      t: "`$INTEGER`"
    }
    map_image: {
      h: "Map Image"
      n: "map_image"
      r: false
      sh: "URL to map image"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the location"
      t: "`$STRING`"
    }
    total_landing_count: {
      h: "Total Landing Count"
      n: "total_landing_count"
      r: false
      sh: "Total number of landings at this location"
      t: "`$INTEGER`"
    }
    total_launch_count: {
      h: "Total Launch Count"
      n: "total_launch_count"
      r: false
      sh: "Total number of launches from this location"
      t: "`$INTEGER`"
    }
    url: {
      h: "Url"
      n: "url"
      r: false
      sh: "API URL for this location"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "location"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /location"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "country_code"
                or: "country_code"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 0
                k: "query"
                n: "offset"
                or: "offset"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "search"
                or: "search"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/location"
          q: {
            exist: [
              "country_code"
              "limit"
              "offset"
              "search"
            ]
          }
          s: [
            {
              lit: "location"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /location/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/location/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "location"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

# Entity: agency

main: kit: entity: agency: {

  alias: field: {}

  fields: [
    {
      name: "abbrev"
      req: false
      short: "Agency abbreviation"
      type: "`$STRING`"
    }
    {
      name: "administrator"
      req: false
      short: "Agency administrator"
      type: "`$STRING`"
    }
    {
      name: "country_code"
      req: false
      short: "ISO country code"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Agency description"
      type: "`$STRING`"
    }
    {
      name: "founding_year"
      req: false
      short: "Year agency was founded"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Agency ID"
      type: "`$INTEGER`"
    }
    {
      name: "logo_url"
      req: false
      short: "URL to agency logo"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the agency"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Type of agency"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "API URL for this agency"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "agency"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "agency_type"
                orig: "agency_type"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "country_code"
                orig: "country_code"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 0
                kind: "query"
                name: "offset"
                orig: "offset"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "search"
                orig: "search"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/agencies"
          parts: [
            "agencies"
          ]
          select: {
            exist: [
              "agency_type"
              "country_code"
              "limit"
              "offset"
              "search"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/agencies/{id}"
          parts: [
            "agencies"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

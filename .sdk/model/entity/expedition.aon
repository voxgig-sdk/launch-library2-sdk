# Entity: expedition

main: kit: entity: expedition: {

  alias: field: {}

  fields: [
    {
      name: "crew"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "end"
      req: false
      short: "End date of the expedition"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Expedition ID"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "Name of the expedition"
      type: "`$STRING`"
    }
    {
      name: "spacestation"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "start"
      req: false
      short: "Start date of the expedition"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "API URL for this expedition"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "expedition"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 0
                kind: "query"
                name: "offset"
                orig: "offset"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "search"
                orig: "search"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "spacestation"
                orig: "spacestation"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/expedition"
          parts: [
            "expedition"
          ]
          select: {
            exist: [
              "limit"
              "offset"
              "search"
              "spacestation"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/expedition/{id}"
          parts: [
            "expedition"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

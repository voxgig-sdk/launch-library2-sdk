# Entity: launch

main: kit: entity: launch: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "UUID of the launch"
      t: "`$STRING`"
    }
    image: {
      h: "Image"
      n: "image"
      r: false
      sh: "URL to launch image"
      t: "`$STRING`"
    }
    launch_service_provider: {
      h: "Launch Service Provider"
      n: "launch_service_provider"
      r: false
      t: "`$OBJECT`"
    }
    mission: {
      h: "Mission"
      n: "mission"
      r: false
      t: "`$OBJECT`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the launch"
      t: "`$STRING`"
    }
    net: {
      fo: "date-time"
      h: "Net"
      n: "net"
      r: false
      sh: "Net Earliest Time (NET) for launch"
      t: "`$STRING`"
    }
    pad: {
      h: "Pad"
      n: "pad"
      r: false
      t: "`$OBJECT`"
    }
    probability: {
      h: "Probability"
      n: "probability"
      r: false
